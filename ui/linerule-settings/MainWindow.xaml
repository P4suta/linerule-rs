<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="Linerule.Settings.MainWindow"
    x:Uid="MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Linerule.Settings"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar x:Name="AppTitleBar" x:Uid="AppTitleBar">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="Assets/linerule.ico" />
            </TitleBar.IconSource>
        </TitleBar>

        <local:MainPage x:Name="RootPage" Grid.Row="1" />
    </Grid>
</Window>
