<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Linerule.Settings.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Linerule.Settings"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModels="using:Linerule.Settings.ViewModels"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel
                MaxWidth="696"
                Margin="32,24,32,24"
                HorizontalAlignment="Stretch"
                Spacing="20">
                <StackPanel Spacing="4">
                    <TextBlock
                        x:Uid="KeyboardShortcutsHeading"
                        Style="{StaticResource TitleTextBlockStyle}" />
                    <TextBlock
                        x:Uid="ShortcutInstructions"
                        Style="{StaticResource BodyTextBlockStyle}"
                        TextWrapping="Wrap" />
                </StackPanel>

                <InfoBar
                    x:Name="StatusInfoBar"
                    AutomationProperties.AutomationId="SettingsStatus"
                    AutomationProperties.LiveSetting="Polite"
                    AutomationProperties.Name="{x:Bind ViewModel.MessageTitle, Mode=OneWay}"
                    IsClosable="True"
                    IsOpen="{x:Bind ViewModel.IsMessageOpen, Mode=TwoWay}"
                    Message="{x:Bind ViewModel.Message, Mode=OneWay}"
                    Severity="{x:Bind local:MainPage.ToInfoBarSeverity(ViewModel.StatusKind), Mode=OneWay}"
                    Title="{x:Bind ViewModel.MessageTitle, Mode=OneWay}" />

                <ItemsControl ItemsSource="{x:Bind ViewModel.Shortcuts, Mode=OneWay}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="viewModels:ShortcutItemViewModel">
                            <controls:SettingsCard
                                Margin="0,0,0,4"
                                AutomationProperties.AutomationId="{x:Bind CardAutomationId, Mode=OneWay}"
                                Description="{x:Bind StatusText, Mode=OneWay}"
                                Header="{x:Bind Label, Mode=OneWay}">
                                <Button
                                    MinWidth="180"
                                    HorizontalContentAlignment="Center"
                                    AutomationProperties.AutomationId="{x:Bind AutomationId, Mode=OneWay}"
                                    AutomationProperties.HelpText="{x:Bind StatusText, Mode=OneWay}"
                                    AutomationProperties.Name="{x:Bind AccessibleName, Mode=OneWay}"
                                    Click="ShortcutButton_Click"
                                    Content="{x:Bind DisplayChord, Mode=OneWay}"
                                    Loaded="ShortcutButton_Loaded"
                                    PreviewKeyDown="ShortcutButton_PreviewKeyDown"
                                    Tag="{x:Bind Mode=OneTime}" />
                            </controls:SettingsCard>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <Border
            Grid.Row="1"
            Padding="32,16,32,20"
            Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button
                    x:Name="ResetButton"
                    x:Uid="ResetButton"
                    Grid.Column="0"
                    AutomationProperties.AutomationId="ResetShortcuts"
                    Click="ResetButton_Click" />
                <Button
                    x:Name="CancelButton"
                    x:Uid="CancelButton"
                    Grid.Column="2"
                    AutomationProperties.AutomationId="CancelSettings"
                    Click="CancelButton_Click" />
                <Button
                    x:Name="SaveButton"
                    x:Uid="SaveButton"
                    Grid.Column="3"
                    AutomationProperties.AutomationId="SaveSettings"
                    Click="SaveButton_Click"
                    Style="{StaticResource AccentButtonStyle}" />
            </Grid>
        </Border>
    </Grid>
</Page>
